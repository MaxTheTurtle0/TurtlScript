diff --git a/benchmarks/types_test.go b/benchmarks/types_test.go
new file mode 100644
--- /dev/null
+++ b/benchmarks/types_test.go
@@ -0,0 +1,66 @@
+package benchmarks
+
+import (
+	"go/interpreter/ast"
+	"go/interpreter/checker"
+	"go/interpreter/evaluator"
+	"go/interpreter/lexer"
+	"go/interpreter/object"
+	"go/interpreter/parser"
+	"strings"
+	"testing"
+)
+
+var checkedSink *checker.Result
+
+func BenchmarkStaticTypes(b *testing.B) {
+	for _, workload := range []struct {
+		name, source string
+		want         int64
+	}{
+		{"small", "let a = 12; let b = 8; if a >= b { (a + b) * 3 ** 2; } else { 0; }", 180},
+		{"large", "let total = 0;\n" + strings.Repeat("let total = total + (17 * 3) % 13;\n", 256) + "total;", 3072},
+		{"factorial", "let fact=fn(n){if n<=1 {return 1;} n*fact(n-1);}; fact(16);", 20922789888000},
+		{"fibonacci", "let fib=fn(n){if n<2 {return n;} fib(n-1)+fib(n-2);}; fib(16);", 987},
+		{"constants", "const scale:int=6; const offset:int=2; const apply=fn(x:int)->int{(x+offset)*scale};apply(5);", 42},
+	} {
+		b.Run(workload.name, func(b *testing.B) {
+			parse := func() *ast.Program {
+				p := parser.New(lexer.New(workload.source))
+				program := p.ParseProgram()
+				if len(p.Errors()) != 0 {
+					b.Fatal(p.Errors())
+				}
+				return program
+			}
+			program := parse()
+			if _, errors := checker.NewSession().Check(program); len(errors) != 0 {
+				b.Fatal(errors)
+			}
+			value := evaluator.Eval(program, object.NewEnvironment())
+			if value, ok := value.(*object.Integer); !ok || value.Value != workload.want {
+				b.Fatal(value)
+			}
+			b.Run("check", func(b *testing.B) {
+				b.ReportAllocs()
+				for i := 0; i < b.N; i++ {
+					checkedSink, _ = checker.NewSession().Check(program)
+				}
+			})
+			b.Run("eval", func(b *testing.B) {
+				b.ReportAllocs()
+				for i := 0; i < b.N; i++ {
+					objectSink = evaluator.Eval(program, object.NewEnvironment())
+				}
+			})
+			b.Run("run", func(b *testing.B) {
+				b.ReportAllocs()
+				for i := 0; i < b.N; i++ {
+					program := parse()
+					checkedSink, _ = checker.NewSession().Check(program)
+					objectSink = evaluator.Eval(program, object.NewEnvironment())
+				}
+			})
+		})
+	}
+}
diff --git a/checker/checker.go b/checker/checker.go
new file mode 100644
--- /dev/null
+++ b/checker/checker.go
@@ -0,0 +1,365 @@
+// Package checker infers and checks types before evaluation. Function types are
+// monomorphic: each function has one signature, rather than implicit generics.
+package checker
+
+import (
+	"fmt"
+	"go/interpreter/ast"
+	"go/interpreter/evaluator"
+	"go/interpreter/object"
+	"go/interpreter/types"
+	"io"
+)
+
+type Binding struct {
+	Type     *types.Type
+	Constant bool
+}
+
+// Session holds only fully resolved, immutable types from executed REPL entries.
+type Session struct {
+	bindings     map[string]Binding
+	builtinReads map[string]map[string]*types.Type
+}
+
+func NewSession() *Session {
+	return &Session{bindings: make(map[string]Binding), builtinReads: make(map[string]map[string]*types.Type)}
+}
+
+type Result struct {
+	Program      *ast.Program
+	bindings     map[string]Binding
+	builtinReads map[string]map[string]*types.Type
+}
+
+// Check does not mutate session state. Failed entries cannot constrain types in
+// later entries. Commit records bindings that actually exist after evaluation.
+func (s *Session) Check(program *ast.Program) (*Result, []string) {
+	env := newScope(nil)
+	loaded := make(map[*types.Type]*term)
+	for name, b := range s.bindings {
+		env.bindings[name] = binding{typ: fromTypeMemo(b.Type, loaded), constant: b.Constant, defined: true}
+	}
+	for name, signatures := range s.builtinReads {
+		for _, typ := range signatures {
+			env.recordRead(name, fromType(typ))
+		}
+	}
+	c := &check{}
+	ctx := &returns{typ: fresh(allKinds)}
+	last, normal := c.block(program.Statements, env, ctx)
+	if ctx.used && normal {
+		c.unify(ctx.typ, last, "program return")
+	}
+	resolved := make(map[string]Binding, len(env.bindings))
+	frozen := make(map[*term]*types.Type)
+	for name, b := range env.bindings {
+		typ := freezeMemo(b.typ, frozen)
+		if typ == nil {
+			c.error("cannot infer type of binding %s; add an annotation", name)
+		} else {
+			resolved[name] = Binding{Type: typ, Constant: b.constant}
+		}
+	}
+	for _, f := range c.functions {
+		if freezeMemo(f.typ, frozen) == nil {
+			c.error("cannot infer complete function signature; annotate its parameters or return type")
+		}
+	}
+	if len(c.errors) != 0 {
+		return nil, c.errors
+	}
+	for _, f := range c.functions {
+		f.node.Signature = freezeMemo(f.typ, frozen)
+	}
+	for _, op := range c.operators {
+		op.node.IntegerOperands = root(op.left).kind == types.IntKind && root(op.right).kind == types.IntKind
+	}
+	for _, op := range c.integerOperators {
+		op.IntegerOperands = true
+	}
+	for _, prefix := range c.prefixes {
+		prefix.IntegerOperand = true
+	}
+	reads := make(map[string]map[string]*types.Type)
+	for name, signatures := range env.outerReads {
+		if _, builtin := evaluator.BuiltinSignature(name); !builtin {
+			continue
+		}
+		reads[name] = make(map[string]*types.Type)
+		for _, signature := range signatures {
+			typ := freezeConstraint(signature)
+			reads[name][typ.String()] = typ
+		}
+	}
+	return &Result{Program: program, bindings: resolved, builtinReads: reads}, nil
+}
+
+func (s *Session) Commit(result *Result, env *object.Environment) {
+	s.builtinReads = result.builtinReads
+	for name, b := range result.bindings {
+		if _, ok := env.Get(name); ok {
+			s.bindings[name] = b
+		}
+	}
+}
+
+func PrintErrors(out io.Writer, errors []string) {
+	fmt.Fprintln(out, "Type errors:")
+	for _, err := range errors {
+		fmt.Fprintln(out, "\t"+err)
+	}
+}
+
+type function struct {
+	node *ast.FunctionLiteral
+	typ  *term
+}
+
+type check struct {
+	errors           []string
+	functions        []function
+	depth            int
+	operators        []integerOperator
+	integerOperators []*ast.InfixExpression
+	prefixes         []*ast.PrefixExpression
+}
+
+type integerOperator struct {
+	node        *ast.InfixExpression
+	left, right *term
+}
+
+type returns struct {
+	typ  *term
+	used bool
+}
+
+func (c *check) error(format string, args ...any) {
+	if len(c.errors) < 100 {
+		c.errors = append(c.errors, fmt.Sprintf(format, args...))
+	}
+}
+
+// normal reports whether an expression can complete without returning.
+func (c *check) block(statements []ast.Statement, env *scope, ctx *returns) (*term, bool) {
+	last := nullTerm
+	normal := true
+	for _, statement := range statements {
+		typ, continues := c.statement(statement, env, ctx)
+		if normal {
+			last, normal = typ, continues
+		}
+	}
+	return last, normal
+}
+
+func (c *check) statement(statement ast.Statement, env *scope, ctx *returns) (*term, bool) {
+	switch node := statement.(type) {
+	case *ast.ExpressionStatement:
+		return c.expression(node.Expression, env, ctx)
+	case *ast.ReturnStatement:
+		typ, normal := c.expression(node.ReturnValue, env, ctx)
+		if normal {
+			ctx.used = true
+			c.unify(ctx.typ, typ, "return value")
+		}
+		return nullTerm, false
+	case *ast.LetStatement:
+		previous, exists := env.bindings[node.Name.Value]
+		if exists && previous.constant {
+			c.error("cannot replace constant: %s", node.Name.Value)
+		}
+		if exists && node.Constant {
+			c.error("cannot redeclare binding as constant: %s", node.Name.Value)
+		}
+		var desired *term
+		if exists {
+			desired = previous.typ
+		}
+		if node.Annotation != nil {
+			annotation := fromType(node.Annotation)
+			if desired == nil {
+				desired = annotation
+			} else {
+				c.unify(desired, annotation, "annotation for "+node.Name.Value)
+			}
+		}
+		var value *term
+		var normal bool
+		fn, directFunction := node.Value.(*ast.FunctionLiteral)
+		if directFunction {
+			if desired == nil {
+				desired = fresh(allKinds)
+			}
+			// The initializer only creates a closure, so recursive references
+			// are safe to check against its signature before checking the body.
+			env.bindings[node.Name.Value] = binding{typ: desired, constant: node.Constant, defined: true}
+			value, normal = c.function(fn, env, desired)
+		} else {
+			value, normal = c.expression(node.Value, env, ctx)
+		}
+		if normal {
+			// An initializer can itself declare this name. Its resulting
+			// binding must survive the outer declaration's type/const checks.
+			// Direct functions only create the recursion placeholder above.
+			if !directFunction {
+				if current, present := env.bindings[node.Name.Value]; present {
+					if current.constant && (!exists || !previous.constant) {
+						c.error("cannot replace constant: %s", node.Name.Value)
+					}
+					if node.Constant && !exists {
+						c.error("cannot redeclare binding as constant: %s", node.Name.Value)
+					}
+					if desired == nil {
+						desired = current.typ
+					} else if root(desired) != root(current.typ) {
+						c.unify(desired, current.typ, "binding "+node.Name.Value+" after initializer")
+					}
+				}
+			}
+			if desired == nil {
+				desired = value
+			} else if root(desired) != root(value) {
+				c.unify(desired, value, "binding "+node.Name.Value)
+			}
+			if !exists {
+				// Closures capture the mutable environment. Include reads made
+				// while checking the initializer, before its final binding can
+				// change what those closures will find at runtime.
+				for _, prior := range env.outerReads[node.Name.Value] {
+					if root(desired) != root(prior) {
+						c.unify(desired, prior, "binding "+node.Name.Value+" shadows an earlier reference")
+					}
+				}
+			}
+			env.bindings[node.Name.Value] = binding{typ: desired, constant: node.Constant, defined: true}
+		}
+		return nullTerm, normal
+	default:
+		c.error("invalid statement")
+		return nullTerm, true
+	}
+}
+
+func (c *check) function(node *ast.FunctionLiteral, env *scope, expected *term) (*term, bool) {
+	params := make([]*term, len(node.Parameters))
+	local := newScope(env)
+	for i, parameter := range node.Parameters {
+		params[i] = fresh(allKinds)
+		if parameter.Annotation != nil {
+			params[i] = fromType(parameter.Annotation)
+		}
+		local.bindings[parameter.Value] = binding{typ: params[i], defined: true}
+	}
+	result := fresh(allKinds)
+	if node.ReturnType != nil {
+		result = fromType(node.ReturnType)
+	}
+	typ := &term{kind: types.FunctionKind, params: params, result: result}
+	if expected != nil {
+		c.unify(expected, typ, "function declaration")
+	}
+	c.functions = append(c.functions, function{node: node, typ: typ})
+	ctx := &returns{typ: result}
+	last, normal := c.block(node.Body.Statements, local, ctx)
+	if normal {
+		c.unify(result, last, "implicit function return")
+	}
+	return typ, true
+}
+
+func (c *check) expression(expression ast.Expression, env *scope, ctx *returns) (*term, bool) {
+	if c.depth >= 512 {
+		c.error("maximum type checking depth exceeded")
+		return nullTerm, true
+	}
+	c.depth++
+	defer func() { c.depth-- }()
+	switch node := expression.(type) {
+	case *ast.IntegerLiteral:
+		return intTerm, true
+	case *ast.StringLiteral:
+		return stringTerm, true
+	case *ast.Boolean:
+		return boolTerm, true
+	case *ast.NullLiteral:
+		return nullTerm, true
+	case *ast.Identifier:
+		if b, ok := env.lookup(node.Value); ok {
+			if !b.defined {
+				c.error("binding %s may not be initialized on every path", node.Value)
+			}
+			return b.typ, true
+		}
+		if signature, ok := evaluator.BuiltinSignature(node.Value); ok {
+			typ := fromType(signature)
+			for current := env; current != nil; current = current.outer {
+				current.recordRead(node.Value, typ)
+			}
+			return typ, true
+		}
+		c.error("identifier not found: %s", node.Value)
+		return fresh(allKinds), true
+	case *ast.FunctionLiteral:
+		return c.function(node, env, nil)
+	case *ast.PrefixExpression:
+		node.IntegerOperand = false
+		right, normal := c.expression(node.Right, env, ctx)
+		if node.Operator == "!" {
+			return boolTerm, normal
+		}
+		if normal {
+			c.unify(right, intTerm, "operator "+node.Operator)
+			c.prefixes = append(c.prefixes, node)
+		}
+		return intTerm, normal
+	case *ast.InfixExpression:
+		return c.infix(node, env, ctx)
+	case *ast.IfExpression:
+		return c.conditional(node, env, ctx)
+	case *ast.CallExpression:
+		callee, functionNormal := c.expression(node.Function, env, ctx)
+		normal := functionNormal
+		args := make([]*term, len(node.Arguments))
+		for i, arg := range node.Arguments {
+			typ, continues := c.expression(arg, env, ctx)
+			if continues {
+				args[i] = typ
+			} else {
+				// A returning argument supplies no value, but runtime dispatch
+				// still checks callability and arity before evaluating it.
+				args[i] = fresh(allKinds)
+			}
+			normal = normal && continues
+		}
+		if !functionNormal {
+			return nullTerm, false
+		}
+		callee = root(callee)
+		if callee.kind == variableKind {
+			result := fresh(allKinds)
+			c.unify(callee, &term{kind: types.FunctionKind, params: args, result: result}, "function call")
+			return result, normal
+		}
+		if callee.kind != types.FunctionKind {
+			c.error("not a function: %s", describe(callee))
+			return fresh(allKinds), normal
+		}
+		if !callee.variadic && len(args) != len(callee.params) {
+			c.error("wrong number of arguments: got=%d, want=%d", len(args), len(callee.params))
+			return callee.result, normal
+		}
+		if !callee.variadic {
+			for i, arg := range args {
+				if root(callee.params[i]) != root(arg) {
+					c.unify(callee.params[i], arg, fmt.Sprintf("argument %d", i+1))
+				}
+			}
+		}
+		return callee.result, normal
+	default:
+		c.error("invalid expression")
+		return nullTerm, true
+	}
+}
diff --git a/checker/checker_test.go b/checker/checker_test.go
new file mode 100644
--- /dev/null
+++ b/checker/checker_test.go
@@ -0,0 +1,281 @@
+package checker
+
+import (
+	"bytes"
+	"fmt"
+	"go/interpreter/ast"
+	"go/interpreter/evaluator"
+	"go/interpreter/lexer"
+	"go/interpreter/object"
+	"go/interpreter/parser"
+	"strings"
+	"testing"
+)
+
+func parse(t *testing.T, source string) *ast.Program {
+	t.Helper()
+	p := parser.New(lexer.New(source))
+	program := p.ParseProgram()
+	if len(p.Errors()) != 0 {
+		t.Fatal(p.Errors())
+	}
+	return program
+}
+
+func TestCheckedPrograms(t *testing.T) {
+	for _, test := range []struct{ source, want string }{
+		{`const answer=42; answer`, "42"},
+		{`const name:string="🐢"; name`, "🐢"},
+		{`let x=if true{let x=1;2};x`, "2"},
+		{`let x:int=if true{let x=1;2};x`, "2"},
+		{`let flag=true;let x=if flag{let x=1;2}else{3};x`, "2"},
+		{`let x=if true{let x=1;let read=fn(){x+1};2};read()`, "3"},
+		{`let x=1;let f=fn(){let x=if true{x+1};x};f()`, "2"},
+		{`let x=1;let make=fn(){fn(){x+1}};let f=fn(){let x=make();x()};f()`, "2"},
+		{`const x=if true{let y=1;y};x`, "1"},
+		{`let x:int=1; let x=2; x`, "2"},
+		{`let id=fn(x){x}; id(3)`, "3"},
+		{`let add=fn(x,y){x+y}; add(1,2)`, "3"},
+		{`let add=fn(x:string,y:string){x+y}; add("a","b")`, "ab"},
+		{`let double=fn(x:int){x*2}; double(21)`, "42"},
+		{`let op:fn(int,int)->int=fn(x,y){x+y}; op(1,2)`, "3"},
+		{`let apply=fn(f:fn(int)->int,x:int)->int{f(x)}; apply(fn(x){x+1},41)`, "42"},
+		{`let make=fn(x){fn(y){x+y}}; let add=make(5); add(3)`, "8"},
+		{`const fact=fn(n){if n<=1{return 1};n*fact(n-1)}; fact(10)`, "3628800"},
+		{`const fact=fn(n:int)->int{if n<=1{return 1};n*fact(n-1)}; fact(10)`, "3628800"},
+		{`let x=7; let f=fn(){const x:string="a";x}; f()`, "a"},
+		{`let b=true; if b {let x=1} else {let x=2}; x`, "1"},
+		{`fn(flag:bool)->int {if flag{return 1};let x=2;x}(false)`, "2"},
+		{`fn(){1 + if true{return 5};99}()`, "5"},
+		{`fn(){slice(if true{return "done"},0,1);"no"}()`, "done"},
+		{`fn(f:fn(string)->int)->int{f(if true{return 5});9}(fn(x:string)->int{1})`, "5"},
+		{`let x=if true{42};x`, "42"},
+		{`fn()->null{}()`, "null"},
+		{`"1" == 1`, "false"},
+		{`str(1)+str(true)+str(null)`, "1truenull"},
+		{`let convert:fn(int)->string=str;convert(42)`, "42"},
+		{`let apply=fn(f:fn(int)->string){f(42)};apply(str)`, "42"},
+		{`let p=print;p(1,"hello",true)`, "null"},
+		{`false && (1/0)`, "false"},
+	} {
+		t.Run(test.source, func(t *testing.T) {
+			program := parse(t, test.source)
+			if _, errors := NewSession().Check(program); len(errors) != 0 {
+				t.Fatal(errors)
+			}
+			value := evaluator.Eval(program, object.NewEnvironment())
+			if value.Inspect() != test.want {
+				t.Fatalf("got %q, want %q", value.Inspect(), test.want)
+			}
+		})
+	}
+}
+
+func TestRejectedPrograms(t *testing.T) {
+	for _, test := range []struct{ source, message string }{
+		{`let x:int="a"`, "type mismatch"},
+		{`let x=1;let x="a"`, "type mismatch"},
+		{`const x=1;let x=2`, "cannot replace constant"},
+		{`const x=1;const x=2`, "cannot replace constant"},
+		{`let x=1;const x=2`, "cannot redeclare binding as constant"},
+		{`fn(x:int)->int{x}(true)`, "type mismatch"},
+		{`fn(x:int)->int{x}()`, "wrong number of arguments"},
+		{`fn(){fn()->int{1}(if true{return 5})}()`, "wrong number of arguments"},
+		{`fn(){42(if true{return 5})}()`, "not a function"},
+		{`fn()->int{"a"}`, "implicit function return"},
+		{`fn()->int{return true}`, "return value"},
+		{`fn(b:bool){if b{return 1};"a"}(true)`, "type mismatch"},
+		{`fn(b:bool){if b{1}else{"a"}}(true)`, "if expression branches"},
+		{`fn(b:bool){if b{1}}(true)`, "if expression branches"},
+		{`let b=true;if b{let x=1};x`, "may not be initialized"},
+		{`let b=true;if b{const x=1};let x=2`, "cannot replace constant"},
+		{`let b=true;if b{let x=1}else{let x="a"};x`, "across branches"},
+		{`let b=true;if b{let x=1}else{const x=1};x`, "consistently let or const"},
+		{`let add=fn(x,y){x+y}`, "cannot infer"},
+		{`let id=fn(x){x};id(1);id("a")`, "type mismatch"},
+		{`fn(x){x(x)}`, "infinite recursive type"},
+		{`let f=fn(){f()};f()`, "cannot infer"},
+		{`len(42)`, "type mismatch"},
+		{`str(fn(){1})`, "incompatible type"},
+		{`print(1);false && missing`, "identifier not found"},
+		{`let x=1;let f=fn(){let g=fn(){x+1};let x="a";g()};f()`, "type mismatch"},
+		{`let x=1;let f=fn(){let x=if true{fn(){x+1}};x()};f()`, "type mismatch"},
+		{`let x=1;let f=fn(){let x=fn(){fn(){x+1}}();x()};f()`, "type mismatch"},
+		{`let x=if true{let x=1;let read=fn(){x+1};"a"};read()`, "type mismatch"},
+		{`let x=if true{const x=1;2};x`, "cannot replace constant"},
+		{`const x=if true{let x=1;2};x`, "cannot redeclare binding as constant"},
+		{`let flag=true;let x=if flag{const x=1;2}else{3};x`, "cannot replace constant"},
+		{`let f=fn(){len("a")};let len=fn(x:int){x};f()`, "type mismatch"},
+		{`let f=fn(){str("a")};let str=fn(x:int)->string{"x"};f()`, "type mismatch"},
+	} {
+		t.Run(test.source, func(t *testing.T) {
+			if result, errors := NewSession().Check(parse(t, test.source)); result != nil || !strings.Contains(strings.Join(errors, "\n"), test.message) {
+				t.Fatalf("got %v, want %q", errors, test.message)
+			}
+		})
+	}
+}
+
+func TestInferredSignatures(t *testing.T) {
+	program := parse(t, `let make=fn(x){fn(y){x+y}};let add=make(5);add(3)`)
+	if _, errors := NewSession().Check(program); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	fn := program.Statements[0].(*ast.LetStatement).Value.(*ast.FunctionLiteral)
+	if fn.Signature.String() != "fn(int) -> fn(int) -> int" {
+		t.Fatal(fn.Signature.String())
+	}
+}
+
+func TestSessionCommitAndFailures(t *testing.T) {
+	session := NewSession()
+	env := object.NewEnvironment()
+	run := func(source string) []string {
+		result, errors := session.Check(parse(t, source))
+		if len(errors) == 0 {
+			evaluator.Eval(result.Program, env)
+			session.Commit(result, env)
+		}
+		return errors
+	}
+	if errors := run(`const cap=10;let x=1`); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if errors := run(`let x="bad";let poison=2`); len(errors) == 0 {
+		t.Fatal("accepted a type change")
+	}
+	if errors := run(`x+2`); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if errors := run(`poison`); len(errors) == 0 {
+		t.Fatal("failed entry committed a binding")
+	}
+	if errors := run(`let cap=20`); len(errors) == 0 {
+		t.Fatal("replaced a constant")
+	}
+	if errors := run(`let saved=3;1/0;let missing=4`); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if errors := run(`saved`); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if errors := run(`missing`); len(errors) == 0 {
+		t.Fatal("runtime failure committed an unexecuted declaration")
+	}
+	var out bytes.Buffer
+	PrintErrors(&out, []string{"bad type"})
+	if out.String() != "Type errors:\n\tbad type\n" {
+		t.Fatal(out.String())
+	}
+}
+
+func TestBuiltinClosureConstraintsSurviveREPLEntries(t *testing.T) {
+	session := NewSession()
+	env := object.NewEnvironment()
+	first, errors := session.Check(parse(t, `let f=fn(){len("abc")};let convert=fn(){str(42)}`))
+	if len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	evaluator.Eval(first.Program, env)
+	session.Commit(first, env)
+	for _, source := range []string{`let len=fn(x:int)->int{x}`, `let str=fn(x:string)->string{x}`} {
+		if _, errors := session.Check(parse(t, source)); len(errors) == 0 {
+			t.Fatalf("accepted incompatible built-in replacement: %s", source)
+		}
+	}
+	entry, errors := session.Check(parse(t, `f()`))
+	if len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if value := evaluator.Eval(entry.Program, env); value.Inspect() != "3" {
+		t.Fatal(value.Inspect())
+	}
+}
+
+func TestSharedHigherOrderTypes(t *testing.T) {
+	// Each identity function duplicates the previous signature in its input
+	// and output. The graph grows linearly, while an expanded tree grows as 2^n.
+	var source strings.Builder
+	source.WriteString(`let f0=fn(x:int)->int{x};`)
+	for i := 1; i <= 80; i++ {
+		fmt.Fprintf(&source, "let f%d=fn(x){x};f%d(f%d);", i, i, i-1)
+	}
+	session := NewSession()
+	entry, errors := session.Check(parse(t, source.String()))
+	if len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	env := object.NewEnvironment()
+	evaluator.Eval(entry.Program, env)
+	session.Commit(entry, env)
+	if _, errors := session.Check(parse(t, `f80(f79)`)); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if _, errors := session.Check(parse(t, `let f80=fn(x:int)->int{x}`)); len(errors) == 0 || len(strings.Join(errors, "\n")) > 10000 {
+		t.Fatalf("unbounded or missing type diagnostic: %v", errors)
+	}
+}
+
+func TestCheckedIntegerEvaluation(t *testing.T) {
+	for _, test := range []struct{ source, value, output string }{
+		{`const f=fn(x:int)->int{print(x);x};f(1)+(f(2)*f(3))`, "7", "1\n2\n3\n"},
+		{`const f=fn()->int{print(7);7};f()/(f()-7)`, "ERROR: division by zero", "7\n7\n"},
+		{`fn(b:bool)->int {3 + if b{return 5}else{2};9}(true)`, "5", ""},
+		{`fn(b:bool)->int {3 + if b{return 5}else{2};9}(false)`, "9", ""},
+		{`-(fn()->int{print(2);2}())+^3`, "-6", "2\n"},
+	} {
+		program := parse(t, test.source)
+		if _, errors := NewSession().Check(program); len(errors) != 0 {
+			t.Fatal(errors)
+		}
+		var output bytes.Buffer
+		env := object.NewEnvironment()
+		env.Output = &output
+		value := evaluator.Eval(program, env)
+		if value.Inspect() != test.value || output.String() != test.output {
+			t.Fatalf("%s: got value=%q output=%q", test.source, value.Inspect(), output.String())
+		}
+	}
+	program := parse(t, `let x:int=3;let f=fn()->int{x+1};f`)
+	if _, errors := NewSession().Check(program); len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	env := object.NewEnvironment()
+	evaluator.Eval(program, env)
+	env.Set("x", &object.String{Value: "wrong from Go"})
+	call := parse(t, `f()`)
+	if value := evaluator.Eval(call, env); value.Type() != object.ERROR_OBJ {
+		t.Fatal("checked evaluation did not guard the embedding boundary")
+	}
+}
+
+func FuzzCheckAndEvaluate(f *testing.F) {
+	for _, source := range []string{`const x:int=42;x`, `fn(x:int)->int{x+1}(2)`, `fn(x){x(x)}`, `let x=1;let x="a"`, `let b=true;if b{let x=1};x`, `let f=fn(){len("a")};let len=fn(x:int){x};f()`, `let x=1;let f=fn(){let x=if true{fn(){x+1}};x()};f()`, `let x=if true{const x=1;2};x`} {
+		f.Add(source)
+	}
+	f.Fuzz(func(t *testing.T, source string) {
+		if len(source) > 2048 {
+			t.Skip()
+		}
+		p := parser.New(lexer.New(source))
+		program := p.ParseProgram()
+		if len(p.Errors()) != 0 {
+			return
+		}
+		result, errors := NewSession().Check(program)
+		if len(errors) != 0 {
+			return
+		}
+		value := evaluator.Eval(result.Program, object.NewEnvironment())
+		if value == nil {
+			t.Fatal("nil evaluation result")
+		}
+		if err, ok := value.(*object.Error); ok {
+			for _, typeFailure := range []string{"type mismatch", "unknown operator", "not a function", "identifier not found", "cannot replace constant", "wrong number of arguments", "expected INTEGER"} {
+				if strings.Contains(err.Message, typeFailure) {
+					t.Fatalf("checker accepted a runtime type failure: %s", err.Message)
+				}
+			}
+		}
+	})
+}
